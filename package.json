{
  "name": "dachametr-local-domain-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:domain": "node --experimental-strip-types --test tests/plot-domain.test.mjs",
    "test:concepts": "node --experimental-strip-types --test tests/design-concepts.test.mjs",
    "test:ui": "node --experimental-strip-types --test tests/ui-state.test.mjs tests/ui-validation.test.mjs tests/ui-app.test.mjs",
    "test": "npm run typecheck && npm run test:domain && npm run test:concepts && npm run test:ui",
    "test:browser": "playwright test",
    "capture:evidence": "node scripts/capture-ui-evidence.mjs",
    "verify:domain": "npm run typecheck && npm run test:domain",
    "verify": "npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "typescript": "5.8.3",
    "vite": "8.3.8"
  }
}
