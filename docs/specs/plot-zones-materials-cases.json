{
  "schema_version": "draft-0.1",
  "description": "Independent handwritten numerical reference cases for the proposed plot/zones/materials slice; specification evidence only, no production implementation",
  "unit_contract": "Inputs are strings. Base lengths m, thickness cm, density kg/m3, packaging L; output volumes L; no intermediate rounding",
  "valid_cases": [
    {
      "id": "single-soil-50l",
      "description": "2x4 m bed, 25cm soil, 50l bag",
      "plot": {
        "length_m": "20",
        "width_m": "30"
      },
      "zones": [
        {
          "id": "bed1",
          "length_m": "2",
          "width_m": "4",
          "layers": [
            {
              "material": "soil",
              "thickness_cm": "25",
              "reserve_percent": "0",
              "package_l": "50",
              "density_kg_m3": null
            }
          ]
        }
      ],
      "expected": {
        "plot_area_m2": "600",
        "zones_area_sum_m2": "8",
        "areas_exceed_plot": false,
        "bom": [
          {
            "material": "soil",
            "package_l": "50",
            "density_kg_m3": null,
            "net_l": "2000",
            "purchase_l": "2000",
            "packages": 40,
            "mass_kg": null
          }
        ]
      }
    },
