  "invalid_number_cases": [
    {
      "input": "",
      "expected_error": "required"
    },
    {
      "input": "  ",
      "expected_error": "required"
    },
    {
      "input": "1,",
      "expected_error": "invalid_number"
    },
    {
      "input": "1,2.3",
      "expected_error": "invalid_number"
    },
    {
      "input": "1 000",
      "expected_error": "invalid_number"
    },
    {
      "input": "1e3",
      "expected_error": "invalid_number"
    },
    {
      "input": "NaN",
      "expected_error": "invalid_number"
    },
    {
      "input": "Infinity",
      "expected_error": "invalid_number"
    },
    {
      "input": "-1",
      "expected_error": "out_of_range",
      "constraints": {
        "min_exclusive": "0",
        "max_inclusive": "100000"
      }
    },
    {
      "input": "0",
      "expected_error": "out_of_range",
      "constraints": {
        "min_exclusive": "0",
        "max_inclusive": "100000"
      }
    },
    {
      "input": "100000.1",
      "expected_error": "out_of_range",
      "constraints": {
        "min_exclusive": "0",
        "max_inclusive": "100000"
      }
    },
    {
      "input": "-0.1",
      "expected_error": "out_of_range",
      "constraints": {
        "min_inclusive": "0",
        "max_inclusive": "100"
      }
    }
  ]
}
